[Unit]
Description=Snapchat Shortcut Automation Bot (one-shot run)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=%i
WorkingDirectory=/home/%i/snap-bot
EnvironmentFile=/home/%i/snap-bot/.env
ExecStart=/home/%i/snap-bot/.venv/bin/python bot.py --now $SNAP_BOT_FLAGS
StandardOutput=journal
StandardError=journal
# Give the full ADB flow up to 3 minutes before systemd kills it
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
