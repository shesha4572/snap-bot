[Unit]
Description=Snapchat Shortcut Automation Bot (one-shot run)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=%i
WorkingDirectory=__DIR__
EnvironmentFile=__DIR__/.env
ExecStart=__DIR__/.venv/bin/python bot.py --now $SNAP_BOT_FLAGS
StandardOutput=journal
StandardError=journal
# Give the full ADB flow up to 3 minutes before systemd kills it
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
